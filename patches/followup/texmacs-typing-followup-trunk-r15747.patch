 src/Typeset/Bridge/typesetter.cpp |  1 +
 src/Typeset/Stack/stacker.cpp     | 11 ++++++++++-
 src/Typeset/Stack/stacker.hpp     |  1 +
 4 files changed, 16 insertions(+), 1 deletion(-)

