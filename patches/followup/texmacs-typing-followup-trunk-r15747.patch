@@ -140,6 +141,7 @@ void
 replace_bridge (bridge& br, tree st, path ip) {
   bridge new_br= make_bridge (br->ttt, st, ip);
   new_br->changes= br->changes;
+  new_br->removed= br->removed;
   br= new_br;
 }
 
