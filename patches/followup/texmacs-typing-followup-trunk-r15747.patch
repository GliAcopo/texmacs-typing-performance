+++ b/src/Typeset/Bridge/typesetter.cpp
@@ -166,6 +166,7 @@ typesetter_rep::typeset () {
     env->touched  = hashmap<string,bool> (false);
   }
   br->typeset (PROCESSED+ WANTED_PARAGRAPH);
