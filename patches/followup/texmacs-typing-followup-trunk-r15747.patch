From 8c381e751764c419da9637e72fdb362b4d6c1d0d Mon Sep 17 00:00:00 2001
From: Gli_acopo <82150202+GliAcopo@users.noreply.github.com>
Date: Wed, 30 Sep 2026 17:15:04 +0200
Subject: [PATCH 3/5] only advance and repaint the animations which are on the
 screen

Once an animation (e.g. an animated gif inserted with <video>) had been
displayed, the editor walked the whole box tree of the document twice per
frame (anim_invalid and anim_next), forever, also after the animation left
the screen: a long document with one animated gif used 75% of a core
while idle, and every key cost about 115 ms instead of 12 ms.

box_rep gets anim_next and anim_invalid restricted to a rectangle, which
skip the boxes whose extents (with ink) miss it and pass it on to their
children, translated.  Animation boxes check their own extents and then
behave as before.  Transformed boxes and effect boxes do not cull their
children by position (their children are transformed, or drawn beyond
their extents), but still skip everything when they are not visible
themselves.  The editor passes the visible part of the document.  When no
visible animation needs repainting, animate() computes the next time
itself (draw_text, which normally does, is not called then), so that the
timer stops.  Animations which were skipped resynchronize when they are
displayed again.
---
 src/Edit/Interface/edit_interface.cpp       | 25 +++++++++++---
 src/Edit/Interface/edit_interface.hpp       |  1 +
 src/Edit/Interface/edit_repaint.cpp         |  3 +-
 src/Typeset/Boxes/Animate/animate_boxes.cpp | 12 +++++++
 src/Typeset/Boxes/Basic/boxes.cpp           | 37 +++++++++++++++++++++
 src/Typeset/Boxes/Modifier/change_boxes.cpp | 11 ++++++
 src/Typeset/boxes.hpp                       |  3 ++
 7 files changed, 87 insertions(+), 5 deletions(-)

diff --git a/src/Edit/Interface/edit_interface.cpp b/src/Edit/Interface/edit_interface.cpp
index 857f9967a..30999c42e 100644
--- a/src/Edit/Interface/edit_interface.cpp
+++ b/src/Edit/Interface/edit_interface.cpp
@@ -199,6 +199,15 @@ edit_interface_rep::invalidate_all () {
   send_invalidate_all (this);
 }
 
+rectangle
+edit_interface_rep::visible_part () {
+  // the part of the document on the screen (animations elsewhere are
+  // neither advanced nor repainted)
+  update_visible ();
+  SI m= 16 * pixel;
+  return rectangle (vx1 - m, vy1 - m, vx2 + m, vy2 + m);
+}
+
 void
 edit_interface_rep::update_visible () {
   SERVER (get_visible (vx1, vy1, vx2, vy2));
@@ -1131,10 +1140,18 @@ edit_interface_rep::apply_changes () {
 
 void
 edit_interface_rep::animate () {
-  if (((double) texmacs_time ()) >= anim_next) {
-    rectangles rs= eb->anim_invalid ();
-    invalidate (rs);
-    stored_rects= rectangles ();
+  double now= (double) texmacs_time ();
+  if (now >= anim_next) {
+    rectangle vis= visible_part ();
+    rectangles rs= eb->anim_invalid (vis);
+    if (is_nil (rs))
+      // nothing to repaint (e.g. the animations left the screen), so that
+      // draw_text will not update anim_next: do it here
+      anim_next= max (now + 25.0, eb->anim_next (vis));
+    else {
+      invalidate (rs);
+      stored_rects= rectangles ();
+    }
   }
 }
 
